{
  "name": "urn-forge",
  "version": "0.2.1",
  "description": "Compile a manifest of definitions, rules and operations into a checked TypeScript harness, Gherkin coverage, a Postgres schema and a diff of breaking changes.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts",
    "./cucumber": "./src/gherkin/steps.ts",
    "./config": "./src/config.ts",
    "./register-tsx": "./src/gherkin/register-tsx.mjs"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "compile:self": "node bin/urn-forge.js compile --config self/urn-forge.config.ts",
    "verify:self": "node bin/urn-forge.js verify --config self/urn-forge.config.ts",
    "test:features": "cucumber-js",
    "test:tarball": "node scripts/test-tarball.mjs",
    "diff:base": "node scripts/diff-base.mjs"
  },
  "dependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@cucumber/gherkin": "^43.0.0",
    "@cucumber/messages": "^35.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "vitest": "^5.1.1"
  },
  "bin": {
    "urn-forge": "./bin/urn-forge.js"
  },
  "files": [
    "AGENTS.md",
    "bin",
    "self",
    "skills",
    "src",
    "templates"
  ]
}
