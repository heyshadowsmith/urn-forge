{
  "name": "urn-forge",
  "version": "0.1.0",
  "description": "Compile a URN-addressed domain manifest into typed contracts and traceable Gherkin checks.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./cucumber": "./src/gherkin/steps.ts",
    "./register-tsx": "./src/gherkin/register-tsx.mjs"
  },
  "bin": {
    "urn-forge": "./bin/urn-forge.js"
  },
  "files": [
    "bin",
    "src",
    "templates"
  ],
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "compile:example": "node bin/urn-forge.js compile --config example/urn-forge.config.ts",
    "compile:self": "node bin/urn-forge.js compile --config self/urn-forge.config.ts",
    "test:features": "cucumber-js",
    "test:features:self": "cucumber-js --profile self",
    "test:features:tutorial": "cucumber-js --profile tutorial-1 && cucumber-js --profile tutorial-2 && cucumber-js --profile tutorial-3",
    "verify:example": "node bin/urn-forge.js verify --config example/urn-forge.config.ts",
    "verify:self": "node bin/urn-forge.js verify --config self/urn-forge.config.ts",
    "verify:tutorial": "node bin/urn-forge.js verify --config tutorial/1-first-domain/urn-forge.config.ts && node bin/urn-forge.js verify --config tutorial/2-declared-errors/urn-forge.config.ts && node bin/urn-forge.js verify --config tutorial/3-strict-coverage/urn-forge.config.ts",
    "test:tarball": "node scripts/test-tarball.mjs",
    "verify:insurance": "node bin/urn-forge.js verify --config insurance/urn-forge.config.ts",
    "test:features:insurance": "cucumber-js --profile insurance",
    "compile:insurance": "node bin/urn-forge.js compile --config insurance/urn-forge.config.ts"
  },
  "dependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@cucumber/gherkin": "^43.0.0",
    "@cucumber/messages": "^35.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "valibot": "^1.5.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "vitest": "^5.1.1"
  }
}
