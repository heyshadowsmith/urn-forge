{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/heyshadowsmith/urn-forge/blob/main/packages/urn-forge/manifest.schema.json",
  "title": "urn-forge manifest",
  "description": "The manifest of an urn-forge domain: its definitions, rules and operations. urn-forge compile checks more than this schema: the names between the parts, the rules and their arguments.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest"
  ],
  "properties": {
    "manifest": {
      "description": "The header of the contract",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "domain",
        "version"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,31}$",
          "description": "The namespace of the contract, and of its URNs"
        },
        "domain": {
          "$ref": "#/$defs/name",
          "description": "The domain of the contract, and the name of its Postgres schema"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
          "description": "A semver version, read by diff and by gate 5"
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "callers"
          ],
          "properties": {
            "callers": {
              "const": "ignore-unknown",
              "description": "Callers ignore a property or an output that they do not know"
            }
          }
        }
      }
    },
    "definitions": {
      "description": "The values: numbers, strings, objects and lists",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/definition"
      }
    },
    "rules": {
      "description": "The text of each rule of the manifest",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/rule"
      }
    },
    "operations": {
      "description": "The operations: an input, the outputs, and their rules",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/operation"
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,62}$"
    },
    "text": {
      "type": "string",
      "pattern": "\\S"
    },
    "names": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/name"
      }
    },
    "ruleUses": {
      "description": "Rules applied by name: `- uniqueItems`, `- minimum: 1`, or `- between: { low: 1, high: 9 }`",
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9_]{0,62}$"
          },
          {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 1,
            "propertyNames": {
              "pattern": "^[a-z][A-Za-z0-9_]{0,62}$"
            }
          }
        ]
      }
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "type"
      ],
      "properties": {
        "description": {
          "$ref": "#/$defs/text"
        },
        "type": {
          "$ref": "#/$defs/name",
          "description": "string, number, integer, boolean, object, array, or the name of another definition"
        },
        "properties": {
          "$ref": "#/$defs/names",
          "description": "type: object: the names of the definitions that are its properties"
        },
        "items": {
          "$ref": "#/$defs/name",
          "description": "type: array: the definition of each item"
        },
        "identifier": {
          "$ref": "#/$defs/name",
          "description": "type: object: a required property with one value, which tells two objects apart"
        },
        "rules": {
          "$ref": "#/$defs/ruleUses"
        },
        "deprecated": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "object"
              }
            }
          },
          "then": {
            "required": [
              "properties"
            ],
            "not": {
              "required": [
                "items"
              ]
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "properties"
                  ]
                },
                {
                  "required": [
                    "identifier"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "array"
              }
            }
          },
          "then": {
            "required": [
              "items"
            ]
          },
          "else": {
            "not": {
              "required": [
                "items"
              ]
            }
          }
        }
      ]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "rule",
        "failure_message"
      ],
      "properties": {
        "description": {
          "$ref": "#/$defs/text",
          "description": "What the rule checks, and why, for a reader of the manifest"
        },
        "parameters": {
          "$ref": "#/$defs/names",
          "description": "The names of definitions: the type of each parameter"
        },
        "rule": {
          "$ref": "#/$defs/text",
          "description": "An expression of the CEL subset that gives true when the value keeps the rule"
        },
        "failure_message": {
          "$ref": "#/$defs/text",
          "description": "What a failure says when the rule breaks; {parameter} puts in its argument"
        },
        "deprecated": {
          "type": "boolean"
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "input",
        "output"
      ],
      "properties": {
        "description": {
          "$ref": "#/$defs/text"
        },
        "input": {
          "$ref": "#/$defs/name",
          "description": "An object definition"
        },
        "output": {
          "description": "The answers: `- <object>: [rules]`, or `- <object>`",
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/name"
              },
              {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 1,
                "propertyNames": {
                  "$ref": "#/$defs/name"
                },
                "additionalProperties": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/ruleUses"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            ]
          }
        },
        "rules": {
          "$ref": "#/$defs/ruleUses",
          "description": "Rules that are true of each answer"
        },
        "deprecated": {
          "type": "boolean"
        }
      }
    }
  }
}
