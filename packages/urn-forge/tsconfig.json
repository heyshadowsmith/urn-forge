{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    // Bundler resolution allows the extensionless import in example/core.ts (written as in
    // mvp-plan.md). src/ and generated code still use explicit `.js` specifiers, which also
    // resolve under NodeNext, so generated files work in either kind of project.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src", "tests", "example", "self", "vitest.config.ts"]
}
