  "events": {
    "urn:demo:clock:claim:event:decision_overdue": {
      "brandIdentifier": "ClaimDecisionOverdue",
      "description": "A claim waits for a decision for 30 days",
      "fields": [
        {
          "field": "urn:demo:clock:claim:field:claim_id",
          "name": "claim_id",
          "required": true
        }
      ],
      "urn": "urn:demo:clock:claim:event:decision_overdue"
    },
    "urn:demo:clock:payment:event:expired": {
      "brandIdentifier": "PaymentExpired",
      "description": "A payment expired, as it was not captured within 7 days",
      "fields": [
        {
          "field": "urn:demo:clock:payment:field:payment_id",
          "name": "payment_id",
          "required": true
        }
      ],
      "urn": "urn:demo:clock:payment:event:expired"
    }
  },
  "fields": {
    "urn:demo:clock:claim:field:claim_id": {
      "brandIdentifier": "ClaimClaimId",
      "constraints": {
        "regex": "CLM-[0-9]{10}"
      },
      "description": "The id of a claim",
      "primitive": "string",
      "urn": "urn:demo:clock:claim:field:claim_id"
    },
    "urn:demo:clock:claim:field:overdue_reported_at": {
      "brandIdentifier": "ClaimOverdueReportedAt",
      "constraints": {},
      "description": "When the claim was reported as overdue, once",
      "primitive": "timestamp",
      "urn": "urn:demo:clock:claim:field:overdue_reported_at"
    },
    "urn:demo:clock:claim:field:state": {
      "brandIdentifier": "ClaimState",
      "constraints": {
        "values": [
          "SUBMITTED",
          "APPROVED"
        ]
      },
      "description": "The state of a claim",
      "moves": {
        "SUBMITTED": [
          "APPROVED"
        ]
      },
      "primitive": "enum",
      "urn": "urn:demo:clock:claim:field:state"
    },
    "urn:demo:clock:claim:field:submitted_at": {
      "brandIdentifier": "ClaimSubmittedAt",
      "constraints": {},
      "description": "When the claim was submitted",
      "primitive": "timestamp",
      "urn": "urn:demo:clock:claim:field:submitted_at"
    },
    "urn:demo:clock:payment:field:authorized_at": {
      "brandIdentifier": "PaymentAuthorizedAt",
      "constraints": {},
      "description": "When the payment was authorized",
      "primitive": "timestamp",
      "urn": "urn:demo:clock:payment:field:authorized_at"
    },
    "urn:demo:clock:payment:field:payment_id": {
      "brandIdentifier": "PaymentPaymentId",
      "constraints": {
        "regex": "pay_[a-z0-9]{8}"
      },
      "description": "The id of a payment",
      "primitive": "string",
      "urn": "urn:demo:clock:payment:field:payment_id"
    },
    "urn:demo:clock:payment:field:status": {
      "brandIdentifier": "PaymentStatus",
      "constraints": {
        "values": [
          "authorized",
          "captured",
          "expired"
        ]
      },
      "description": "The status of a payment",
      "moves": {
        "authorized": [
          "captured",
          "expired"
        ]
      },
      "primitive": "enum",
      "urn": "urn:demo:clock:payment:field:status"
    }
  },
  "invariants": {},
  "meta": {
    "domain": "clock",
    "irSchemaVersion": 1,
    "manifestHash": "b014439cba2c0d0d124612e6296128bae53ad88d3508016d2d954d1c913fd4cd",
    "manifestVersion": "1.0.0",
    "namespace": "demo",
    "stability": "stable"
  },
  "operations": {
    "urn:demo:clock:claim:operation:report_overdue": {
      "brandIdentifier": "ClaimReportOverdue",
      "changes": {
        "entity": "urn:demo:clock:claim:entity:claim",
        "from": [
          "SUBMITTED"
        ],
        "otherwise": "urn:demo:clock:claim:error:invalid_state",
        "property": "state"
      },
      "description": "Report a claim that waits for a decision for 30 days, once, with no change of state",
      "due": {
        "rule": {
          "left": {
            "field": "current.overdue_reported_at",
            "op": "absent"
          },
          "op": "and",
          "right": {
            "left": {
              "name": "now",
              "op": "field"
            },
            "op": ">=",
            "right": {
              "left": {
                "name": "current.submitted_at",
                "op": "field"
              },
              "op": "+",
              "right": {
                "op": "duration",
                "unit": "days",
                "value": {
                  "op": "number",
                  "value": "30"
                }
              }
            }
          }
        },
        "ruleText": "current.overdue_reported_at is absent and now >= current.submitted_at + 30 days"
      },
      "emits": [
        "urn:demo:clock:claim:event:decision_overdue"
      ],
      "ensures": [
        {
          "rule": {
            "left": {
              "field": "output.overdue_reported_at",
              "op": "present"
            },
            "op": "and",
            "right": {
              "left": {
                "name": "output.overdue_reported_at",
                "op": "field"
              },
              "op": "=",
              "right": {
                "name": "now",
                "op": "field"
              }
            }
          },
          "ruleText": "output.overdue_reported_at is present and output.overdue_reported_at = now"
        }
      ],
      "errors": [
        "urn:demo:clock:claim:error:invalid_state"
      ],
      "exactly": [
        {
          "event": "urn:demo:clock:claim:event:decision_overdue"
        }
      ],
      "input": "urn:demo:clock:claim:entity:claim_ref",
      "output": "urn:demo:clock:claim:entity:claim",
      "urn": "urn:demo:clock:claim:operation:report_overdue"
    },
    "urn:demo:clock:payment:operation:capture_payment": {
      "brandIdentifier": "PaymentCapturePayment",
      "changes": {
        "entity": "urn:demo:clock:payment:entity:payment",
        "from": [
          "authorized"
        ],
        "otherwise": "urn:demo:clock:payment:error:invalid_status",
        "property": "status",
        "to": [
          "captured"
        ]
      },
      "description": "Capture an authorized payment within 7 days",
      "emits": [],
      "errors": [
        "urn:demo:clock:payment:error:invalid_status"
      ],
      "input": "urn:demo:clock:payment:entity:payment_ref",
      "output": "urn:demo:clock:payment:entity:payment",
      "requires": [
        {
          "otherwise": "urn:demo:clock:payment:error:invalid_status",
          "rule": {
            "left": {
              "name": "now",
              "op": "field"
            },
            "op": "<",
            "right": {
              "left": {
                "name": "current.authorized_at",
                "op": "field"
              },
              "op": "+",
              "right": {
                "op": "duration",
                "unit": "days",
                "value": {
                  "op": "number",
                  "value": "7"
                }
              }
            }
          },
          "ruleText": "now < current.authorized_at + 7 days"
        }
      ],
      "urn": "urn:demo:clock:payment:operation:capture_payment"
    },
    "urn:demo:clock:payment:operation:expire_payment": {
      "brandIdentifier": "PaymentExpirePayment",
      "changes": {
        "entity": "urn:demo:clock:payment:entity:payment",
        "from": [
          "authorized"
        ],
        "otherwise": "urn:demo:clock:payment:error:invalid_status",
        "property": "status",
        "to": [
          "expired"
        ]
      },
      "description": "Expire an authorized payment that was not captured within 7 days",
      "due": {
        "rule": {
          "left": {
            "name": "now",
            "op": "field"
          },
          "op": ">=",
          "right": {
            "left": {
              "name": "current.authorized_at",
              "op": "field"
            },
            "op": "+",
            "right": {
              "op": "duration",
              "unit": "days",
              "value": {
                "op": "number",
                "value": "7"
              }
            }
          }
        },
        "ruleText": "now >= current.authorized_at + 7 days"
      },
      "emits": [
        "urn:demo:clock:payment:event:expired"
      ],
      "errors": [
        "urn:demo:clock:payment:error:invalid_status"
      ],
      "exactly": [
        {
          "event": "urn:demo:clock:payment:event:expired"
        }
      ],
      "input": "urn:demo:clock:payment:entity:payment_ref",
      "output": "urn:demo:clock:payment:entity:payment",
      "urn": "urn:demo:clock:payment:operation:expire_payment"
    }
  }
}
