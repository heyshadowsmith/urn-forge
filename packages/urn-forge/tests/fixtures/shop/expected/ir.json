{
  "entities": {
    "urn:demo:shop:order:entity:line": {
      "brandIdentifier": "OrderLine",
      "description": "One line of an order",
      "fields": [
        {
          "field": "urn:demo:shop:order:field:sku",
          "name": "sku",
          "required": true
        },
        {
          "field": "urn:demo:shop:order:field:quantity",
          "name": "quantity",
          "required": true
        },
        {
          "field": "urn:demo:shop:order:field:unit_cost",
          "name": "unit_cost",
          "required": true
        },
        {
          "field": "urn:demo:shop:order:field:note",
          "name": "note",
          "required": false
        },
        {
          "field": "urn:demo:shop:order:field:gift_wrap",
          "name": "gift_wrap",
          "required": false
        },
        {
          "field": "urn:demo:shop:order:field:delivery",
          "name": "delivery",
          "required": false
        },
        {
          "field": "urn:demo:shop:order:field:tracking_url",
          "name": "tracking_url",
          "required": false
        },
        {
          "field": "urn:demo:shop:order:field:terms_accepted",
          "name": "terms_accepted",
          "required": true
        }
      ],
      "urn": "urn:demo:shop:order:entity:line"
    },
    "urn:demo:shop:order:entity:line_total": {
      "brandIdentifier": "OrderLineTotal",
      "description": "The cost of one line",
      "fields": [
        {
          "field": "urn:demo:shop:order:field:total",
          "name": "total",
          "required": true
        }
      ],
      "urn": "urn:demo:shop:order:entity:line_total"
    }
  },
  "errors": {
    "urn:demo:shop:order:error:price_unavailable": {
      "brandIdentifier": "OrderPriceUnavailable",
      "category": "not_found",
      "description": "No price is known for the item",
      "fields": [
        {
          "field": "urn:demo:shop:order:field:sku",
          "name": "sku",
          "required": true
        }
      ],
      "message": [
        {
          "text": "No price for "
        },
        {
          "field": "sku"
        }
      ],
      "retryable": false,
      "urn": "urn:demo:shop:order:error:price_unavailable"
    },
    "urn:demo:shop:order:error:pricing_offline": {
      "brandIdentifier": "OrderPricingOffline",
      "category": "precondition",
      "description": "Prices cannot be read now",
      "fields": [],
      "message": [
        {
          "text": "Pricing is offline; try again later"
        }
      ],
      "retryable": true,
      "urn": "urn:demo:shop:order:error:pricing_offline"
    }
  },
  "fields": {
    "urn:demo:shop:order:field:delivery": {
      "brandIdentifier": "OrderDelivery",
      "constraints": {
        "values": [
          "standard",
          "express",
          "click & collect"
        ]
      },
      "primitive": "enum",
      "urn": "urn:demo:shop:order:field:delivery"
    },
    "urn:demo:shop:order:field:gift_wrap": {
      "brandIdentifier": "OrderGiftWrap",
      "constraints": {},
      "primitive": "boolean",
      "urn": "urn:demo:shop:order:field:gift_wrap"
    },
    "urn:demo:shop:order:field:note": {
      "brandIdentifier": "OrderNote",
      "constraints": {
        "maxLength": 140,
        "minLength": 1
      },
      "primitive": "string",
      "urn": "urn:demo:shop:order:field:note"
    },
    "urn:demo:shop:order:field:quantity": {
      "brandIdentifier": "OrderQuantity",
      "constraints": {
        "max": 99,
        "min": 1,
        "notIn": [
          13
        ]
      },
      "primitive": "integer",
      "urn": "urn:demo:shop:order:field:quantity"
    },
    "urn:demo:shop:order:field:sku": {
      "brandIdentifier": "OrderSku",
      "constraints": {
        "regex": "[A-Z]{3}-[0-9]{4}"
      },
      "primitive": "string",
      "urn": "urn:demo:shop:order:field:sku"
    },
    "urn:demo:shop:order:field:terms_accepted": {
      "brandIdentifier": "OrderTermsAccepted",
      "constraints": {
        "mustBe": true
      },
      "description": "The buyer accepted the terms",
      "primitive": "boolean",
      "urn": "urn:demo:shop:order:field:terms_accepted"
    },
    "urn:demo:shop:order:field:total": {
      "brandIdentifier": "OrderTotal",
      "constraints": {
        "min": 0
      },
      "primitive": "float",
      "urn": "urn:demo:shop:order:field:total"
    },
    "urn:demo:shop:order:field:tracking_url": {
      "brandIdentifier": "OrderTrackingUrl",
      "constraints": {
        "regex": "https://track\\.example/[0-9]+"
      },
      "primitive": "string",
      "urn": "urn:demo:shop:order:field:tracking_url"
    },
    "urn:demo:shop:order:field:unit_cost": {
      "brandIdentifier": "OrderUnitCost",
      "constraints": {
        "min": 0
      },
      "description": "Price of one unit",
      "primitive": "float",
      "urn": "urn:demo:shop:order:field:unit_cost"
    }
  },
  "meta": {
    "domain": "shop",
    "irSchemaVersion": 1,
    "manifestHash": "d4c169dd42a434843570fb0ffea7ddc6e99909b5f8af60941bc73c8091b8730e",
    "manifestVersion": "0.1.0",
    "namespace": "demo",
    "stability": "stable"
  },
  "operations": {
    "urn:demo:shop:order:operation:price_line": {
      "brandIdentifier": "OrderPriceLine",
      "description": "Price one order line",
      "errors": [
        "urn:demo:shop:order:error:price_unavailable",
        "urn:demo:shop:order:error:pricing_offline"
      ],
      "input": "urn:demo:shop:order:entity:line",
      "output": "urn:demo:shop:order:entity:line_total",
      "urn": "urn:demo:shop:order:operation:price_line"
    }
  }
}
