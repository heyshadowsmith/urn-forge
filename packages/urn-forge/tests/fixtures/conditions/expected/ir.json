    "urn:demo:conditions:claim:field:version": {
      "brandIdentifier": "ClaimVersion",
      "constraints": {
        "min": 1
      },
      "description": "The version of a claim",
      "primitive": "integer",
      "urn": "urn:demo:conditions:claim:field:version"
    },
