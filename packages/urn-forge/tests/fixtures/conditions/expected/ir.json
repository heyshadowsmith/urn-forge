  "meta": {
    "domain": "conditions",
    "irSchemaVersion": 1,
    "manifestHash": "7af50de4b26856d51151d30519e829c180512c878a50376f2bc6be25a5d24140",
    "manifestVersion": "1.0.0",
    "namespace": "demo",
    "stability": "stable"
  },
  "operations": {
    "urn:demo:conditions:booking:operation:create_booking": {
      "brandIdentifier": "BookingCreateBooking",
      "description": "Make a booking",
      "emits": [],
      "errors": [
        "urn:demo:conditions:booking:error:party_too_large_for_online",
        "urn:demo:conditions:booking:error:deposit_required"
      ],
      "input": "urn:demo:conditions:booking:entity:request",
      "output": "urn:demo:conditions:booking:entity:booking",
      "requires": [
        {
          "otherwise": "urn:demo:conditions:booking:error:party_too_large_for_online",
          "rule": {
            "left": {
              "name": "input.party_size",
              "op": "field"
            },
            "op": "<",
            "right": {
              "op": "number",
              "value": "13"
            }
          },
          "ruleText": "input.party_size < 13"
        },
        {
          "otherwise": "urn:demo:conditions:booking:error:deposit_required",
          "rule": {
            "left": {
              "left": {
                "name": "input.party_size",
                "op": "field"
              },
              "op": "<",
              "right": {
                "op": "number",
                "value": "7"
              }
            },
            "op": "or",
            "right": {
              "field": "input.deposit_token",
              "op": "present"
            }
          },
          "ruleText": "input.party_size < 7 or input.deposit_token is present"
        }
      ],
      "urn": "urn:demo:conditions:booking:operation:create_booking"
    },
    "urn:demo:conditions:claim:operation:submit_claim": {
      "brandIdentifier": "ClaimSubmitClaim",
      "changes": {
        "entity": "urn:demo:conditions:claim:entity:claim",
        "from": [
          "DRAFT"
        ],
        "otherwise": "urn:demo:conditions:claim:error:invalid_state",
        "property": "state",
        "to": [
          "SUBMITTED"
        ]
      },
      "description": "Submit a draft claim",
      "emits": [],
      "ensures": [
        {
          "rule": {
            "left": {
              "name": "output.version",
              "op": "field"
            },
            "op": "=",
            "right": {
              "left": {
                "name": "input.version",
                "op": "field"
              },
              "op": "+",
              "right": {
                "op": "number",
                "value": "1"
              }
            }
          },
          "ruleText": "output.version = input.version + 1"
        }
      ],
      "errors": [
        "urn:demo:conditions:claim:error:invalid_state",
        "urn:demo:conditions:claim:error:version_conflict"
      ],
      "input": "urn:demo:conditions:claim:entity:change",
      "output": "urn:demo:conditions:claim:entity:claim",
      "requires": [
        {
          "fill": {
            "stored_version": "current.version",
            "version": "input.version"
          },
          "otherwise": "urn:demo:conditions:claim:error:version_conflict",
          "rule": {
            "left": {
              "name": "input.version",
              "op": "field"
            },
            "op": "=",
            "right": {
              "name": "current.version",
              "op": "field"
            }
          },
          "ruleText": "input.version = current.version"
        }
      ],
      "urn": "urn:demo:conditions:claim:operation:submit_claim"
    },
    "urn:demo:conditions:payment:operation:refund_payment": {
      "brandIdentifier": "PaymentRefundPayment",
      "changes": {
        "entity": "urn:demo:conditions:payment:entity:payment",
        "from": [
          "captured"
        ],
        "otherwise": "urn:demo:conditions:payment:error:not_captured",
        "property": "status"
      },
      "description": "Refund part of a payment",
      "emits": [],
      "ensures": [
        {
          "rule": {
            "left": {
              "name": "output.refunded_amount",
              "op": "field"
            },
            "op": "=",
            "right": {
              "left": {
                "name": "current.refunded_amount",
                "op": "field"
              },
              "op": "+",
              "right": {
                "name": "input.amount",
                "op": "field"
              }
            }
          },
          "ruleText": "output.refunded_amount = current.refunded_amount + input.amount"
        }
      ],
      "errors": [
        "urn:demo:conditions:payment:error:not_captured",
        "urn:demo:conditions:payment:error:amount_exceeds_captured"
      ],
      "input": "urn:demo:conditions:payment:entity:refund_request",
      "output": "urn:demo:conditions:payment:entity:payment",
      "requires": [
        {
          "otherwise": "urn:demo:conditions:payment:error:amount_exceeds_captured",
          "rule": {
            "left": {
              "left": {
                "name": "current.refunded_amount",
                "op": "field"
              },
              "op": "+",
              "right": {
                "name": "input.amount",
                "op": "field"
              }
            },
            "op": "<=",
            "right": {
              "name": "current.captured_amount",
              "op": "field"
            }
          },
          "ruleText": "current.refunded_amount + input.amount <= current.captured_amount"
        }
      ],
      "urn": "urn:demo:conditions:payment:operation:refund_payment"
    }
  }
}
