    "urn:demo:conditions:claim:field:stored_version": {
      "brandIdentifier": "ClaimStoredVersion",
      "constraints": {
        "min": 1
      },
      "description": "The version of the claim as it is stored",
      "primitive": "integer",
      "urn": "urn:demo:conditions:claim:field:stored_version"
