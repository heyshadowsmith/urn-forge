  "invariants": {
    "urn:demo:lists:claim:invariant:total_is_sum": {
      "brandIdentifier": "ClaimTotalIsSum",
      "description": "The total of a claim is the sum of its lines",
      "message": "The total must be the sum of the line amounts",
      "on": "urn:demo:lists:claim:entity:claim",
      "rule": {
        "left": {
          "name": "total",
          "op": "field"
        },
        "op": "=",
        "right": {
          "item": "line",
          "list": "lines",
          "op": "sum",
          "value": {
            "name": "line.amount",
            "op": "field"
          }
        }
      },
      "ruleText": "total = sum(line in lines: line.amount)",
      "urn": "urn:demo:lists:claim:invariant:total_is_sum"
    },
    "urn:demo:lists:payment:invariant:amount_is_sum": {
      "brandIdentifier": "PaymentAmountIsSum",
      "description": "The amount of a payment with items is the sum of quantity times unit amount",
      "message": "The amount must be the sum of quantity times unit amount",
      "on": "urn:demo:lists:payment:entity:request",
      "rule": {
        "left": {
          "field": "line_items",
          "op": "absent"
        },
        "op": "or",
        "right": {
          "left": {
            "name": "amount",
            "op": "field"
          },
          "op": "=",
          "right": {
            "item": "item",
            "list": "line_items",
            "op": "sum",
            "value": {
              "left": {
                "name": "item.quantity",
                "op": "field"
              },
              "op": "*",
              "right": {
                "name": "item.unit_amount",
                "op": "field"
              }
            }
          }
        }
      },
      "ruleText": "line_items is absent or amount = sum(item in line_items: item.quantity * item.unit_amount)",
      "urn": "urn:demo:lists:payment:invariant:amount_is_sum"
    }
  },
