    },
    "urn:demo:lists:subscription:operation:change_plan": {
      "brandIdentifier": "SubscriptionChangePlan",
      "changes": {
        "entity": "urn:demo:lists:subscription:entity:subscription",
        "from": [
          "active"
        ],
        "otherwise": "urn:demo:lists:subscription:error:invalid_state",
        "property": "status"
      },
      "description": "Change the plan of a subscription",
      "emits": [],
      "ensures": [
        {
          "rule": {
            "left": {
              "left": {
                "name": "input.proration",
                "op": "field"
              },
              "op": "!=",
              "right": {
                "op": "text",
                "value": "at_period_end"
              }
            },
            "op": "or",
            "right": {
              "left": {
                "name": "output.plan",
                "op": "field"
              },
              "op": "=",
              "right": {
                "name": "current.plan",
                "op": "field"
              }
            }
          },
          "ruleText": "input.proration != 'at_period_end' or output.plan = current.plan"
        }
      ],
      "errors": [
        "urn:demo:lists:subscription:error:invalid_state"
      ],
      "input": "urn:demo:lists:subscription:entity:change",
      "output": "urn:demo:lists:subscription:entity:subscription",
      "urn": "urn:demo:lists:subscription:operation:change_plan"
    }
  }
