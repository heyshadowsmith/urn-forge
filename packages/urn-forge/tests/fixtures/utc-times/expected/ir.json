{
  "entities": {
    "urn:demo:utc:billing:entity:period": {
      "brandIdentifier": "BillingPeriod",
      "description": "A billing period of one calendar month",
      "fields": [
        {
          "field": "urn:demo:utc:billing:field:period_start",
          "name": "period_start",
          "required": true
        },
        {
          "field": "urn:demo:utc:billing:field:period_end",
          "name": "period_end",
          "required": true
        }
      ],
      "urn": "urn:demo:utc:billing:entity:period"
    },
    "urn:demo:utc:billing:entity:plan": {
      "brandIdentifier": "BillingPlan",
      "description": "A plan, from a day to the same day one calendar month on",
      "fields": [
        {
          "field": "urn:demo:utc:billing:field:plan_id",
          "name": "plan_id",
          "required": true
        },
        {
          "field": "urn:demo:utc:billing:field:starts_on",
          "name": "starts_on",
          "required": true
        },
        {
          "field": "urn:demo:utc:billing:field:ends_on",
          "name": "ends_on",
          "required": true
        }
      ],
      "key": "urn:demo:utc:billing:field:plan_id",
      "urn": "urn:demo:utc:billing:entity:plan"
    },
    "urn:demo:utc:stock:entity:receipt": {
      "brandIdentifier": "StockReceipt",
      "description": "Goods that arrived",
      "fields": [
        {
          "field": "urn:demo:utc:stock:field:sku",
          "name": "sku",
          "required": true
        },
        {
          "field": "urn:demo:utc:stock:field:received_at",
          "name": "received_at",
          "required": true
        }
      ],
      "key": "urn:demo:utc:stock:field:sku",
      "urn": "urn:demo:utc:stock:entity:receipt"
    }
  },
  "errors": {},
  "events": {},
  "fields": {
    "urn:demo:utc:billing:field:ends_on": {
      "brandIdentifier": "BillingEndsOn",
      "constraints": {},
      "description": "The last day of a plan, one calendar month on",
      "primitive": "date",
      "urn": "urn:demo:utc:billing:field:ends_on"
    },
    "urn:demo:utc:billing:field:period_end": {
      "brandIdentifier": "BillingPeriodEnd",
      "constraints": {},
      "description": "The end of a billing period, in UTC",
      "primitive": "timestamp",
      "urn": "urn:demo:utc:billing:field:period_end"
    },
    "urn:demo:utc:billing:field:period_start": {
      "brandIdentifier": "BillingPeriodStart",
      "constraints": {},
      "description": "The start of a billing period, in UTC",
      "primitive": "timestamp",
      "urn": "urn:demo:utc:billing:field:period_start"
    },
    "urn:demo:utc:billing:field:plan_id": {
      "brandIdentifier": "BillingPlanId",
      "constraints": {
        "regex": "pln_[a-z0-9]{4}"
      },
      "description": "The id of a plan",
      "primitive": "string",
      "urn": "urn:demo:utc:billing:field:plan_id"
    },
    "urn:demo:utc:billing:field:starts_on": {
      "brandIdentifier": "BillingStartsOn",
      "constraints": {},
      "description": "The first day of a plan",
      "primitive": "date",
      "urn": "urn:demo:utc:billing:field:starts_on"
    },
    "urn:demo:utc:stock:field:received_at": {
      "brandIdentifier": "StockReceivedAt",
      "constraints": {
        "precision": 3
      },
      "description": "When the goods arrived, in UTC, with milliseconds",
      "primitive": "timestamp",
      "urn": "urn:demo:utc:stock:field:received_at"
    },
    "urn:demo:utc:stock:field:sku": {
      "brandIdentifier": "StockSku",
      "constraints": {
        "regex": "[A-Z0-9-]{1,12}"
      },
      "description": "A stock code",
      "primitive": "string",
      "urn": "urn:demo:utc:stock:field:sku"
    }
  },
  "invariants": {
    "urn:demo:utc:billing:invariant:one_month": {
      "brandIdentifier": "BillingOneMonth",
      "description": "A plan lasts one calendar month",
      "message": "A plan ends one calendar month after it starts",
      "on": "urn:demo:utc:billing:entity:plan",
      "rule": {
        "left": {
          "name": "ends_on",
          "op": "field"
        },
        "op": "=",
        "right": {
          "left": {
            "name": "starts_on",
            "op": "field"
          },
          "op": "+",
          "right": {
            "op": "duration",
            "unit": "months",
            "value": {
              "op": "number",
              "value": "1"
            }
          }
        }
      },
      "ruleText": "ends_on = starts_on + 1 months",
      "urn": "urn:demo:utc:billing:invariant:one_month"
    }
  },
  "meta": {
    "domain": "utc",
    "irSchemaVersion": 1,
    "manifestHash": "09be48d91333b28ebb5ec456e74289239e5c9ceb68a18784c96c0fca85844a18",
    "manifestVersion": "1.0.0",
    "namespace": "demo",
    "stability": "stable"
  },
  "operations": {
    "urn:demo:utc:billing:operation:renew": {
      "brandIdentifier": "BillingRenew",
      "description": "Start the next billing period, one calendar month long",
      "emits": [],
      "ensures": [
        {
          "rule": {
            "left": {
              "name": "output.period_start",
              "op": "field"
            },
            "op": "=",
            "right": {
              "name": "input.period_end",
              "op": "field"
            }
          },
          "ruleText": "output.period_start = input.period_end"
        },
        {
          "rule": {
            "left": {
              "name": "output.period_end",
              "op": "field"
            },
            "op": "=",
            "right": {
              "left": {
                "name": "output.period_start",
                "op": "field"
              },
              "op": "+",
              "right": {
                "op": "duration",
                "unit": "months",
                "value": {
                  "op": "number",
                  "value": "1"
                }
              }
            }
          },
          "ruleText": "output.period_end = output.period_start + 1 months"
        }
      ],
      "errors": [],
      "input": "urn:demo:utc:billing:entity:period",
      "output": "urn:demo:utc:billing:entity:period",
      "urn": "urn:demo:utc:billing:operation:renew"
    },
    "urn:demo:utc:stock:operation:receive": {
      "brandIdentifier": "StockReceive",
      "description": "Record goods that arrived",
      "emits": [],
      "errors": [],
      "input": "urn:demo:utc:stock:entity:receipt",
      "output": "urn:demo:utc:stock:entity:receipt",
      "urn": "urn:demo:utc:stock:operation:receive"
    }
  }
}
