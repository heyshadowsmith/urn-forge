      "fields": [
        {
          "field": "urn:demo:sums:claim:field:claim_id",
          "name": "claim_id",
          "required": true
        },
        {
          "field": "urn:demo:sums:claim:field:total",
          "name": "total",
          "required": true
        },
        {
          "entity": "urn:demo:sums:claim:entity:line",
          "many": {
            "maxItems": 50,
            "minItems": 1
          },
          "name": "lines",
          "required": true
        }
      ],
      "key": "urn:demo:sums:claim:field:claim_id",
      "urn": "urn:demo:sums:claim:entity:claim"
    },
    "urn:demo:sums:claim:entity:line": {
      "brandIdentifier": "ClaimLine",
      "description": "One line of a claim",
      "fields": [
        {
          "field": "urn:demo:sums:claim:field:amount",
          "name": "amount",
          "required": true
        },
        {
          "field": "urn:demo:sums:claim:field:note",
          "name": "note",
          "required": false
        }
      ],
      "urn": "urn:demo:sums:claim:entity:line"
    },
    "urn:demo:sums:invoice:entity:invoice": {
      "brandIdentifier": "InvoiceInvoice",
      "description": "An invoice whose total is the sum of its lines",
      "fields": [
        {
          "entity": "urn:demo:sums:money:entity:money",
          "name": "total",
          "required": true
        },
        {
          "entity": "urn:demo:sums:invoice:entity:line",
          "many": {
            "minItems": 1
          },
          "name": "lines",
          "required": true
        }
      ],
      "urn": "urn:demo:sums:invoice:entity:invoice"
    },
    "urn:demo:sums:invoice:entity:line": {
      "brandIdentifier": "InvoiceLine",
      "description": "One line of an invoice",
      "fields": [
        {
          "entity": "urn:demo:sums:money:entity:money",
          "name": "amount",
          "required": true
        }
      ],
      "urn": "urn:demo:sums:invoice:entity:line"
    },
    "urn:demo:sums:money:entity:money": {
      "brandIdentifier": "MoneyMoney",
      "description": "An amount with its currency",
      "fields": [
        {
          "field": "urn:demo:sums:money:field:amount_minor",
          "name": "amount_minor",
          "required": true
        },
        {
          "field": "urn:demo:sums:money:field:currency",
          "name": "currency",
          "required": true
        }
      ],
      "urn": "urn:demo:sums:money:entity:money"
    },
    "urn:demo:sums:payment:entity:item": {
      "brandIdentifier": "PaymentItem",
      "description": "One item of a payment",
      "fields": [
        {
          "field": "urn:demo:sums:payment:field:quantity",
          "name": "quantity",
          "required": true
        },
        {
          "field": "urn:demo:sums:payment:field:unit_amount",
          "name": "unit_amount",
          "required": true
        }
      ],
      "urn": "urn:demo:sums:payment:entity:item"
    },
    "urn:demo:sums:payment:entity:request": {
      "brandIdentifier": "PaymentRequest",
      "description": "A payment, with its items when it has them",
      "fields": [
        {
          "field": "urn:demo:sums:payment:field:amount",
          "name": "amount",
          "required": true
        },
        {
          "entity": "urn:demo:sums:payment:entity:item",
          "many": {
            "maxItems": 100,
            "minItems": 1
          },
          "name": "line_items",
          "required": false
        }
      ],
      "urn": "urn:demo:sums:payment:entity:request"
    }
  },
  "errors": {},
  "events": {},
  "fields": {
    "urn:demo:sums:claim:field:amount": {
      "brandIdentifier": "ClaimAmount",
      "constraints": {
        "min": "0.01",
        "scale": 2
      },
      "description": "The amount of one line",
      "primitive": "decimal",
      "urn": "urn:demo:sums:claim:field:amount"
    },
    "urn:demo:sums:claim:field:claim_id": {
      "brandIdentifier": "ClaimClaimId",
      "constraints": {
        "regex": "CLM-[0-9]{4}"
      },
      "description": "The id of a claim",
      "primitive": "string",
      "urn": "urn:demo:sums:claim:field:claim_id"
    },
    "urn:demo:sums:claim:field:note": {
      "brandIdentifier": "ClaimNote",
      "constraints": {},
      "description": "A note on a line",
      "primitive": "string",
      "urn": "urn:demo:sums:claim:field:note"
    },
    "urn:demo:sums:claim:field:total": {
      "brandIdentifier": "ClaimTotal",
      "constraints": {
        "min": "0.00",
        "scale": 2
      },
      "description": "The total of a claim",
      "primitive": "decimal",
      "urn": "urn:demo:sums:claim:field:total"
    },
    "urn:demo:sums:money:field:amount_minor": {
      "brandIdentifier": "MoneyAmountMinor",
      "constraints": {
        "min": 0
      },
      "description": "An amount in minor units",
      "primitive": "integer",
      "urn": "urn:demo:sums:money:field:amount_minor"
    },
    "urn:demo:sums:money:field:currency": {
      "brandIdentifier": "MoneyCurrency",
      "constraints": {
        "regex": "[A-Z]{3}"
      },
      "description": "A currency",
      "primitive": "string",
      "urn": "urn:demo:sums:money:field:currency"
    },
    "urn:demo:sums:payment:field:amount": {
      "brandIdentifier": "PaymentAmount",
      "constraints": {
        "min": "0.01",
        "scale": 2
      },
      "description": "An amount",
      "primitive": "decimal",
      "urn": "urn:demo:sums:payment:field:amount"
    },
    "urn:demo:sums:payment:field:quantity": {
      "brandIdentifier": "PaymentQuantity",
      "constraints": {
        "min": 1
      },
      "description": "How many of an item",
      "primitive": "integer",
      "urn": "urn:demo:sums:payment:field:quantity"
    },
    "urn:demo:sums:payment:field:unit_amount": {
      "brandIdentifier": "PaymentUnitAmount",
      "constraints": {
        "min": "0.00",
        "scale": 2
      },
      "description": "The price of one item",
      "primitive": "decimal",
      "urn": "urn:demo:sums:payment:field:unit_amount"
    }
  },
  "invariants": {
    "urn:demo:sums:claim:invariant:total_is_sum": {
      "brandIdentifier": "ClaimTotalIsSum",
      "description": "The total of a claim is the sum of its lines",
      "message": "The total must be the sum of the line amounts",
      "on": "urn:demo:sums:claim:entity:claim",
      "rule": {
        "left": {
          "name": "total",
          "op": "field"
        },
        "op": "=",
        "right": {
          "item": "line",
          "list": "lines",
          "op": "sum",
          "value": {
            "name": "line.amount",
            "op": "field"
          }
        }
      },
      "ruleText": "total = sum(line in lines: line.amount)",
      "urn": "urn:demo:sums:claim:invariant:total_is_sum"
    },
    "urn:demo:sums:invoice:invariant:total_is_sum": {
      "brandIdentifier": "InvoiceTotalIsSum",
      "description": "The total of an invoice is the sum of its line amounts, in minor units",
      "message": "The total must be the sum of the line amounts",
      "on": "urn:demo:sums:invoice:entity:invoice",
      "rule": {
        "left": {
          "name": "total.amount_minor",
          "op": "field"
        },
        "op": "=",
        "right": {
          "item": "line",
          "list": "lines",
          "op": "sum",
          "value": {
            "name": "line.amount.amount_minor",
            "op": "field"
          }
        }
      },
      "ruleText": "total.amount_minor = sum(line in lines: line.amount.amount_minor)",
      "urn": "urn:demo:sums:invoice:invariant:total_is_sum"
    },
    "urn:demo:sums:payment:invariant:amount_is_sum": {
      "brandIdentifier": "PaymentAmountIsSum",
      "description": "The amount of a payment with items is the sum of quantity times unit amount",
      "message": "The amount must be the sum of quantity times unit amount",
      "on": "urn:demo:sums:payment:entity:request",
      "rule": {
        "left": {
          "field": "line_items",
          "op": "absent"
        },
        "op": "or",
        "right": {
          "left": {
            "name": "amount",
            "op": "field"
          },
          "op": "=",
          "right": {
            "item": "item",
            "list": "line_items",
            "op": "sum",
            "value": {
              "left": {
                "name": "item.quantity",
                "op": "field"
              },
              "op": "*",
              "right": {
                "name": "item.unit_amount",
                "op": "field"
              }
            }
          }
        }
      },
      "ruleText": "line_items is absent or amount = sum(item in line_items: item.quantity * item.unit_amount)",
      "urn": "urn:demo:sums:payment:invariant:amount_is_sum"
    }
  },
  "meta": {
    "domain": "sums",
    "irSchemaVersion": 1,
    "manifestHash": "0baf19fdd5c886b593df4b6d513e785b125d1afe6bd3f429ad450f71b4edda03",
