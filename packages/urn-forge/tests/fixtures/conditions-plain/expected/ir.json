{
  "entities": {
    "urn:demo:conditions:booking:entity:booking": {
      "brandIdentifier": "BookingBooking",
      "description": "A booking",
      "fields": [
        {
          "field": "urn:demo:conditions:booking:field:reference",
          "name": "reference",
          "required": true
        },
        {
          "field": "urn:demo:conditions:booking:field:party_size",
          "name": "party_size",
          "required": true
        }
      ],
      "urn": "urn:demo:conditions:booking:entity:booking"
    },
    "urn:demo:conditions:booking:entity:request": {
      "brandIdentifier": "BookingRequest",
      "description": "A request for a table",
      "fields": [
        {
          "field": "urn:demo:conditions:booking:field:party_size",
          "name": "party_size",
          "required": true
        },
        {
          "field": "urn:demo:conditions:booking:field:deposit_token",
          "name": "deposit_token",
          "required": false
        }
      ],
      "urn": "urn:demo:conditions:booking:entity:request"
    }
  },
  "errors": {
    "urn:demo:conditions:booking:error:deposit_required": {
      "brandIdentifier": "BookingDepositRequired",
      "category": "validation",
      "description": "A party of 7 or more pays a deposit",
      "fields": [
        {
          "field": "urn:demo:conditions:booking:field:party_size",
          "name": "party_size",
          "required": true
        }
      ],
      "message": [
        {
          "text": "A party of "
        },
        {
          "field": "party_size"
        },
        {
          "text": " needs a deposit"
        }
      ],
      "retryable": false,
      "urn": "urn:demo:conditions:booking:error:deposit_required"
    },
    "urn:demo:conditions:booking:error:party_too_large_for_online": {
      "brandIdentifier": "BookingPartyTooLargeForOnline",
      "category": "validation",
      "description": "A party of 13 or more books by phone",
      "fields": [
        {
          "field": "urn:demo:conditions:booking:field:party_size",
          "name": "party_size",
          "required": true
        }
      ],
      "message": [
        {
          "text": "A party of "
        },
        {
          "field": "party_size"
        },
        {
          "text": " books by phone"
        }
      ],
      "retryable": false,
      "urn": "urn:demo:conditions:booking:error:party_too_large_for_online"
    }
  },
  "events": {},
  "fields": {
    "urn:demo:conditions:booking:field:deposit_token": {
      "brandIdentifier": "BookingDepositToken",
      "constraints": {
        "minLength": 1
      },
      "description": "A token that pays the deposit",
      "primitive": "string",
      "urn": "urn:demo:conditions:booking:field:deposit_token"
    },
    "urn:demo:conditions:booking:field:party_size": {
      "brandIdentifier": "BookingPartySize",
      "constraints": {
        "max": 20,
        "min": 1
      },
      "description": "The number of guests",
      "primitive": "integer",
      "urn": "urn:demo:conditions:booking:field:party_size"
    },
    "urn:demo:conditions:booking:field:reference": {
      "brandIdentifier": "BookingReference",
      "constraints": {
        "regex": "[A-Z]{8}"
      },
      "description": "The reference of a booking",
      "primitive": "string",
      "urn": "urn:demo:conditions:booking:field:reference"
    }
  },
  "invariants": {},
  "meta": {
    "domain": "conditions",
    "irSchemaVersion": 1,
    "manifestHash": "aa5ddc75dc74db4f6e722662f3e4b06734fa373efd99288bb100c38be92d69f9",
    "manifestVersion": "1.0.0",
    "namespace": "demo",
    "stability": "stable"
  },
  "operations": {
    "urn:demo:conditions:booking:operation:create_booking": {
      "brandIdentifier": "BookingCreateBooking",
      "description": "Make a booking",
      "emits": [],
      "errors": [
        "urn:demo:conditions:booking:error:party_too_large_for_online",
        "urn:demo:conditions:booking:error:deposit_required"
      ],
      "input": "urn:demo:conditions:booking:entity:request",
      "output": "urn:demo:conditions:booking:entity:booking",
      "requires": [
        {
          "otherwise": "urn:demo:conditions:booking:error:party_too_large_for_online",
          "rule": {
            "left": {
              "name": "input.party_size",
              "op": "field"
            },
            "op": "<",
            "right": {
              "op": "number",
              "value": "13"
            }
          },
          "ruleText": "input.party_size < 13"
        },
        {
          "otherwise": "urn:demo:conditions:booking:error:deposit_required",
          "rule": {
            "left": {
              "left": {
                "name": "input.party_size",
                "op": "field"
              },
              "op": "<",
              "right": {
                "op": "number",
                "value": "7"
              }
            },
            "op": "or",
            "right": {
              "field": "input.deposit_token",
              "op": "present"
            }
          },
          "ruleText": "input.party_size < 7 or input.deposit_token is present"
        }
      ],
      "urn": "urn:demo:conditions:booking:operation:create_booking"
    }
  }
}
