        ]
      },
      "description": "The status of a hold",
      "moves": {
        "ACTIVE": [
          "CONVERTED"
        ]
      },
      "primitive": "enum",
      "urn": "urn:demo:time:hold:field:status"
    },
    "urn:demo:time:pause:field:resume_on": {
      "brandIdentifier": "PauseResumeOn",
      "constraints": {},
