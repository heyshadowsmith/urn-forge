      "urn": "urn:demo:time:pause:field:resume_on"
    },
    "urn:demo:time:payment:field:captured_at": {
      "brandIdentifier": "PaymentCapturedAt",
      "constraints": {},
      "description": "When the payment was captured",
      "primitive": "timestamp",
      "urn": "urn:demo:time:payment:field:captured_at"
    },
    "urn:demo:time:payment:field:payment_id": {
      "brandIdentifier": "PaymentPaymentId",
      "constraints": {
        "regex": "pay_[a-z0-9]{8}"
