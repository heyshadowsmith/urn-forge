  "invariants": {},
  "meta": {
    "domain": "time",
    "irSchemaVersion": 1,
    "manifestHash": "41df96b7abab3138100fe081cebbfe9c1ed87f77fd59c4319f1ab688fb60c131",
    "manifestVersion": "1.0.0",
    "namespace": "demo",
    "stability": "stable"
  },
  "operations": {
    "urn:demo:time:hold:operation:check_out": {
      "brandIdentifier": "HoldCheckOut",
      "changes": {
        "entity": "urn:demo:time:hold:entity:hold",
        "from": [
          "ACTIVE"
        ],
        "otherwise": "urn:demo:time:hold:error:invalid_status",
        "property": "status",
        "to": [
          "CONVERTED"
        ]
      },
      "description": "Check out an active hold before it expires",
      "emits": [],
      "errors": [
        "urn:demo:time:hold:error:invalid_status",
        "urn:demo:time:hold:error:hold_expired"
      ],
      "input": "urn:demo:time:hold:entity:hold_ref",
      "output": "urn:demo:time:hold:entity:hold",
      "requires": [
        {
          "otherwise": "urn:demo:time:hold:error:hold_expired",
          "rule": {
            "left": {
              "name": "now",
              "op": "field"
            },
            "op": "<",
            "right": {
              "name": "current.expires_at",
              "op": "field"
            }
          },
          "ruleText": "now < current.expires_at"
        }
      ],
      "urn": "urn:demo:time:hold:operation:check_out"
    },
    "urn:demo:time:pause:operation:pause": {
      "brandIdentifier": "PausePause",
      "description": "Pause, until a resume date from 1 to 90 days after today",
      "emits": [],
      "errors": [
        "urn:demo:time:pause:error:invalid_resume_date"
      ],
      "input": "urn:demo:time:pause:entity:request",
      "output": "urn:demo:time:pause:entity:request",
      "requires": [
        {
          "otherwise": "urn:demo:time:pause:error:invalid_resume_date",
          "rule": {
            "left": {
              "field": "input.resume_on",
              "op": "absent"
            },
            "op": "or",
            "right": {
              "left": {
                "left": {
                  "name": "input.resume_on",
                  "op": "field"
                },
                "op": ">=",
                "right": {
                  "left": {
                    "name": "today",
                    "op": "field"
                  },
                  "op": "+",
                  "right": {
                    "op": "number",
                    "value": "1"
                  }
                }
              },
              "op": "and",
              "right": {
                "left": {
                  "name": "input.resume_on",
                  "op": "field"
                },
                "op": "<=",
                "right": {
                  "left": {
                    "name": "today",
                    "op": "field"
                  },
                  "op": "+",
                  "right": {
                    "op": "number",
                    "value": "90"
                  }
                }
              }
            }
          },
          "ruleText": "input.resume_on is absent or input.resume_on >= today + 1 and input.resume_on <= today + 90"
        }
      ],
      "urn": "urn:demo:time:pause:operation:pause"
    },
    "urn:demo:time:payment:operation:refund_payment": {
      "brandIdentifier": "PaymentRefundPayment",
      "changes": {
        "entity": "urn:demo:time:payment:entity:payment",
        "from": [
          "captured"
        ],
        "otherwise": "urn:demo:time:payment:error:invalid_status",
        "property": "status",
        "to": [
          "refunded"
        ]
      },
      "description": "Refund a captured payment, at most 180 days after the capture",
      "emits": [],
      "ensures": [
        {
          "rule": {
            "left": {
              "field": "output.refunded_at",
              "op": "present"
            },
            "op": "and",
            "right": {
              "left": {
                "name": "output.refunded_at",
                "op": "field"
              },
              "op": "=",
              "right": {
                "name": "now",
                "op": "field"
              }
            }
          },
          "ruleText": "output.refunded_at is present and output.refunded_at = now"
        }
      ],
      "errors": [
        "urn:demo:time:payment:error:invalid_status",
        "urn:demo:time:payment:error:refund_window_closed"
      ],
      "input": "urn:demo:time:payment:entity:payment_ref",
      "output": "urn:demo:time:payment:entity:payment",
      "requires": [
        {
          "otherwise": "urn:demo:time:payment:error:refund_window_closed",
          "rule": {
            "left": {
              "name": "now",
              "op": "field"
            },
            "op": "<=",
            "right": {
              "left": {
                "name": "current.captured_at",
                "op": "field"
              },
              "op": "+",
              "right": {
                "op": "duration",
                "unit": "days",
                "value": {
                  "op": "number",
                  "value": "180"
                }
              }
            }
          },
          "ruleText": "now <= current.captured_at + 180 days"
        }
      ],
      "urn": "urn:demo:time:payment:operation:refund_payment"
    }
  }
}
