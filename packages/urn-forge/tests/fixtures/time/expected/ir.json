  "events": {},
  "fields": {
    "urn:demo:time:hold:field:expires_at": {
      "brandIdentifier": "HoldExpiresAt",
      "constraints": {},
      "description": "When the hold expires",
      "primitive": "timestamp",
      "urn": "urn:demo:time:hold:field:expires_at"
    },
    "urn:demo:time:hold:field:hold_id": {
      "brandIdentifier": "HoldHoldId",
      "constraints": {
        "regex": "hld_[a-z0-9]{8}"
      },
      "description": "The id of a hold",
      "primitive": "string",
      "urn": "urn:demo:time:hold:field:hold_id"
    },
    "urn:demo:time:hold:field:status": {
      "brandIdentifier": "HoldStatus",
      "constraints": {
        "values": [
