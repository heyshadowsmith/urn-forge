        {
          "field": "urn:demo:delivery:payment:field:status",
          "name": "status",
          "required": true
        },
        {
          "field": "urn:demo:delivery:payment:field:amount",
          "name": "amount",
          "required": true
        }
      ],
      "urn": "urn:demo:delivery:payment:event:pending"
