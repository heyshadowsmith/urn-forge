  "fields": {
    "urn:demo:delivery:event:field:event_id": {
      "brandIdentifier": "EventEventId",
      "constraints": {
        "format": "uuid"
      },
      "description": "The id of one event, for de-duplication",
      "primitive": "string",
      "urn": "urn:demo:delivery:event:field:event_id"
    },
    "urn:demo:delivery:event:field:sequence": {
      "brandIdentifier": "EventSequence",
      "constraints": {
        "min": 1
      },
      "description": "The place of an event in the order of its payment, from 1",
      "primitive": "integer",
      "urn": "urn:demo:delivery:event:field:sequence"
    },
    "urn:demo:delivery:payment:field:amount": {
      "brandIdentifier": "PaymentAmount",
      "constraints": {
        "min": 1
      },
      "description": "An amount in minor units",
      "primitive": "integer",
      "urn": "urn:demo:delivery:payment:field:amount"
    },
    "urn:demo:delivery:payment:field:payment_id": {
      "brandIdentifier": "PaymentPaymentId",
      "constraints": {
        "regex": "pay_[a-z0-9]{8}"
      },
      "description": "The id of a payment",
      "primitive": "string",
      "urn": "urn:demo:delivery:payment:field:payment_id"
    },
    "urn:demo:delivery:payment:field:status": {
      "brandIdentifier": "PaymentStatus",
      "constraints": {
        "values": [
          "pending",
          "authorized",
          "captured"
        ]
      },
      "description": "The status of a payment",
      "moves": {
        "authorized": [
          "captured"
        ],
        "pending": [
          "authorized"
        ]
      },
      "primitive": "enum",
      "urn": "urn:demo:delivery:payment:field:status"
    }
  },
  "invariants": {},
  "meta": {
    "domain": "delivery",
    "irSchemaVersion": 1,
    "manifestHash": "baf4e7fdfe6960f6b9dd7c0bed443c7f69c1541066d5838cc1a47484ed2bd10e",
    "manifestVersion": "1.0.0",
    "namespace": "demo",
    "stability": "stable"
  },
  "operations": {
    "urn:demo:delivery:payment:operation:capture_payment": {
      "brandIdentifier": "PaymentCapturePayment",
      "changes": {
        "entity": "urn:demo:delivery:payment:entity:payment",
        "from": [
          "authorized"
        ],
        "otherwise": "urn:demo:delivery:payment:error:invalid_status",
        "property": "status",
        "to": [
          "captured"
        ]
      },
      "description": "Capture an authorized payment",
      "emits": [
        "urn:demo:delivery:payment:event:captured"
      ],
      "ensures": [
        {
          "rule": {
            "left": {
              "name": "event.payment_id",
              "op": "field"
            },
            "op": "=",
            "right": {
              "name": "output.payment_id",
              "op": "field"
            }
          },
          "ruleText": "event.payment_id = output.payment_id"
        },
        {
          "rule": {
            "left": {
              "name": "event.status",
              "op": "field"
            },
            "op": "=",
            "right": {
              "name": "output.status",
              "op": "field"
            }
          },
          "ruleText": "event.status = output.status"
        },
        {
          "rule": {
            "left": {
              "name": "event.previous_status",
              "op": "field"
            },
            "op": "=",
            "right": {
              "name": "current.status",
              "op": "field"
            }
          },
          "ruleText": "event.previous_status = current.status"
        }
      ],
      "errors": [
        "urn:demo:delivery:payment:error:invalid_status"
      ],
      "exactly": [
        {
          "event": "urn:demo:delivery:payment:event:captured"
        }
      ],
      "input": "urn:demo:delivery:payment:entity:payment_ref",
      "output": "urn:demo:delivery:payment:entity:payment",
      "urn": "urn:demo:delivery:payment:operation:capture_payment"
    },
    "urn:demo:delivery:payment:operation:create_payment": {
      "brandIdentifier": "PaymentCreatePayment",
      "description": "Create a payment, which the bank authorizes now or later",
      "emits": [
        "urn:demo:delivery:payment:event:authorized",
        "urn:demo:delivery:payment:event:pending"
      ],
      "ensures": [
        {
          "rule": {
            "left": {
              "name": "event.payment_id",
              "op": "field"
            },
            "op": "=",
            "right": {
              "name": "output.payment_id",
              "op": "field"
            }
          },
          "ruleText": "event.payment_id = output.payment_id"
        },
        {
          "rule": {
            "left": {
              "name": "event.status",
              "op": "field"
            },
            "op": "=",
            "right": {
              "name": "output.status",
              "op": "field"
            }
          },
          "ruleText": "event.status = output.status"
        }
      ],
      "errors": [],
      "exactly": [
        {
          "event": "urn:demo:delivery:payment:event:authorized",
          "when": {
            "rule": {
              "left": {
                "name": "output.status",
                "op": "field"
              },
              "op": "=",
              "right": {
                "op": "text",
                "value": "authorized"
              }
            },
            "ruleText": "output.status = 'authorized'"
          }
        },
        {
          "event": "urn:demo:delivery:payment:event:pending",
          "when": {
            "rule": {
              "left": {
                "name": "output.status",
                "op": "field"
              },
              "op": "=",
              "right": {
                "op": "text",
                "value": "pending"
              }
            },
            "ruleText": "output.status = 'pending'"
          }
        }
      ],
      "input": "urn:demo:delivery:payment:entity:request",
      "output": "urn:demo:delivery:payment:entity:payment",
      "urn": "urn:demo:delivery:payment:operation:create_payment"
    }
  }
}
