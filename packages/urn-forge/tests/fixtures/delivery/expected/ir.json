        ],
        "sequence": "sequence"
      },
      "description": "A payment was captured",
      "fields": [
        {
          "field": "urn:demo:delivery:event:field:event_id",
          "name": "event_id",
          "required": true
        },
        {
          "field": "urn:demo:delivery:event:field:sequence",
          "name": "sequence",
          "required": true
        },
        {
          "field": "urn:demo:delivery:payment:field:payment_id",
          "name": "payment_id",
          "required": true
        },
        {
          "field": "urn:demo:delivery:payment:field:status",
          "name": "status",
