      | enum                | write_status   | compile_report | true  | [{"domain": "urn:a:b", "status": "kept", "path": "a.ts"}] |                                                                  |                                        |          |          |                                                 | []                                                                                                |
      | minLength           | file_path      | compile_report | true  | [{"domain": "urn:a:b", "status": "wrote", "path": ""}]   |                                                                  |                                        |          |          |                                                 | []                                                                                                |
      | required            | problem        | compile_report | false |                                                           |                                                                  |                                        |          |          |                                                 | [{"code": "usage", "severity": "error", "message": "M"}]                                          |
      | pattern             | problem_message | compile_report | false |                                                          |                                                                  |                                        |          |          |                                                 | [{"code": "usage", "severity": "error", "message": " ", "fix": "F"}]                              |
      | minimum             | line_number    | compile_report | false |                                                           |                                                                  |                                        |          |          |                                                 | [{"code": "usage", "severity": "error", "line": 0, "message": "M", "fix": "F"}]                   |
      | minimum             | key_index      | compile_report | false |                                                           |                                                                  |                                        |          |          |                                                 | [{"code": "usage", "severity": "error", "path": ["rules", -1], "message": "M", "fix": "F"}]       |
      | required            | verify_report  | verify_report  | true  |                                                           |                                                                  |                                        |          |          |                                                 |                                                                                                   |
