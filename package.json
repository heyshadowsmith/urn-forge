{
  "name": "urn-forge",
  "version": "0.1.0",
  "description": "Compile a URN-addressed domain manifest into typed contracts and traceable Gherkin checks.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "urn-forge": "./bin/urn-forge.js"
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "compile:example": "node bin/urn-forge.js compile --manifest tests/fixtures/math.manifest.yaml --out example/generated",
    "test:features": "cucumber-js",
    "verify:example": "node bin/urn-forge.js verify --manifest tests/fixtures/math.manifest.yaml --out example/generated --core example/core.ts --features example/features"
  },
  "dependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@cucumber/gherkin": "^43.0.0",
    "@cucumber/messages": "^35.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "valibot": "^1.5.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "vitest": "^5.1.1"
  }
}
