{
  "name": "urn-forge-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "scripts": {
    "test": "npm run test --workspace urn-forge",
    "typecheck": "npm run typecheck --workspace urn-forge",
    "verify:example": "npm run verify:example --workspace urn-forge",
    "test:features": "npm run test:features --workspace urn-forge",
    "docs:dev": "npm run dev --workspace urn-forge-docs",
    "docs:build": "npm run build --workspace urn-forge-docs",
    "docs:preview": "npm run preview --workspace urn-forge-docs"
  }
}
