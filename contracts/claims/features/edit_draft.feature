      | employee    | emp-1              | CLM-0000000999 | 1       | emp-1    | Client visit in Basel | CHF      | [{"category": "LODGING", "expense_date": "2026-11-03", "description": "Hotel", "amount": 9000, "receipt": {"sha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", "media_type": "image/png", "size_bytes": 80000}}, {"category": "MEALS", "expense_date": "2026-11-03", "description": "Lunch", "amount": 2000}] | []              | {"claim_id": "CLM-0000000123", "version": 1, "employee_id": "emp-1", "manager_id": "mgr-1", "state": "DRAFT", "purpose": "Client visit in Bern", "currency": "EUR", "total": 2000, "lines": [{"category": "MEALS", "expense_date": "2026-11-03", "description": "Lunch", "amount": 2000}]} |
