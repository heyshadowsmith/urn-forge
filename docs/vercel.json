{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": ".vitepress/dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/tutorials/:path*",
      "destination": "/methodology",
      "permanent": true
    },
    {
      "source": "/how-to/:path*",
      "destination": "/methodology",
      "permanent": true
    },
    {
      "source": "/reference/:path*",
      "destination": "/methodology",
      "permanent": true
    },
    {
      "source": "/explanation/:path*",
      "destination": "/methodology",
      "permanent": true
    }
  ]
}
